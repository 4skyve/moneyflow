# Database (MySQL) — pakai layanan online seperti PlanetScale, Railway, Aiven, atau TiDB Cloud
# Format: mysql://user:password@host:port/database_name
DATABASE_URL="mysql://user:password@host:3306/moneyflow"

# NextAuth
# Generate dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak"

# Email (Resend) — dipakai untuk kirim kode reset password
# 1. Daftar gratis di https://resend.com
# 2. Ambil API key dari dashboard
# 3. Untuk testing cepat, RESEND_FROM_EMAIL boleh dikosongkan (pakai onboarding@resend.dev,
#    tapi cuma bisa kirim ke email yang kamu pakai daftar Resend).
# 4. Untuk kirim ke SEMUA user beneran, verifikasi domain sendiri di Resend lalu isi ini:
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="MoneyFlow <noreply@domainkamu.com>"
